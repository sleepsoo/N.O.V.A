{"cases": [{"case_id": "4fa07144-04e5-4116-a18e-88d8a90cc21a", "version": 1, "initial": {"opening": "\uc800\ub294 \ubc15\uc120\ud76c\uc774\uace0, \uc608\uc21c\ub450 \uc0b4 \uc5ec\uc790\uc774\ub2e4. \uc7a0\uc744 \uc798 \ubabb \uc790\uc11c \ubcd1\uc6d0\uc5d0 \uc654\ub2e4. \uc218\uba74\uc81c\ub97c \ucc98\ubc29\ud574 \ub2ec\ub77c\uace0 \uc654\ub2e4.", "vital_signs": "\ud608\uc555 : 128/78 mmHg\n\ub9e5\ubc15 : 76 \ud68c/\ubd84\n\ud638\ud761 : 18 \ud68c/\ubd84\n\uccb4\uc628 : 36.6\u00b0C"}, "explanation": "\uacf5\uac1c \uc0d8\ud50c C01. \ub300\ubcf8, \uc9c4\ucc30 \uacb0\uacfc\ud45c, \ubaa8\ubc94 \ucd08\uc9c4\uae30\ub85d\uc740 \uac1c\ubc1c \uac00\uc774\ub4dc\uc758 \uacf5\uac1c \uc0d8\ud50c ZIP(C01 \ud3f4\ub354)\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.", "accepted_diagnoses": ["\uc218\uba74\uc81c \uc758\uc874 (Sedative-Hypnotic Use Disorder)", "\uc218\uba74\uc81c \uc758\uc874", "\uc218\uba74\uc81c \uc758\uc874\uc99d", "\uc878\ud53c\ub380 \uc758\uc874", "\uc218\uba74\uc81c \uc0ac\uc6a9\uc7a5\uc560", "\uc9c4\uc815\uc81c\u00b7\uc218\uba74\uc81c \uc0ac\uc6a9\uc7a5\uc560", "Sedative-Hypnotic Use Disorder", "Sedative, Hypnotic, or Anxiolytic Use Disorder"]}, {"case_id": "35dd8b69-2531-454e-bb8c-fb8030293447", "version": 1, "initial": {"opening": "\uc774\ub984\uc740 \ucd5c\uc724\uc815\uc774\uace0, \ub098\ub294 \uc11c\ub978\ub450 \uc0b4 \uc5ec\uc790\uc774\ub2e4. \ucd5c\uadfc \uc11d \ub2ec \ub3d9\uc548 \uc0b4\uc774 \ub9ce\uc774 \ube60\uc838\uc11c \ubcd1\uc6d0\uc5d0 \uc624\uac8c \ub418\uc5c8\ub2e4. \uc6d0\ub798 \ubab8\ubb34\uac8c\ub294 \uc624\uc2ed\uc721 \ud0a4\ub85c\uadf8\ub78c \uc815\ub3c4\uc600\ub294\ub370, \ucd5c\uadfc \uc11d \ub2ec \uc0ac\uc774\uc5d0 \uce60 \ud0a4\ub85c\uadf8\ub78c \uc815\ub3c4 \ube60\uc838\uc11c \uc9c0\uae08\uc740 \uc0ac\uc2ed\uad6c \ud0a4\ub85c\uadf8\ub78c \uc815\ub3c4\uc774\ub2e4. \ud3c9\uc18c\uc5d0\ub294 \ubab8\ubb34\uac8c \ubcc0\ud654\uac00 \uac70\uc758 \uc5c6\uc5c8\ub294\ub370, \uc774\ubc88\uc5d0\ub294 \ub2e4\uc774\uc5b4\ud2b8\ub098 \uc6b4\ub3d9\uc744 \ud55c \uac83\ub3c4 \uc544\ub2cc\ub370 \uc800\uc808\ub85c \uc0b4\uc774 \ube60\uc838\uc11c \uac71\uc815\uc774 \ub418\uc5c8\ub2e4. \ud0a4\ub294 \ubc31\uc721\uc2ed\uc0ac \uc13c\ud2f0\ubbf8\ud130\uc774\ub2e4.", "vital_signs": "\ud608\uc555 : 138/72 mmHg\n\ub9e5\ubc15 : 102 \ud68c/\ubd84\n\ud638\ud761 : 19 \ud68c/\ubd84\n\uccb4\uc628 : 36.9\u00b0C"}, "explanation": "\uacf5\uac1c \uc0d8\ud50c C10. \ub300\ubcf8, \uc9c4\ucc30 \uacb0\uacfc\ud45c, \ubaa8\ubc94 \ucd08\uc9c4\uae30\ub85d\uc740 \uac1c\ubc1c \uac00\uc774\ub4dc\uc758 \uacf5\uac1c \uc0d8\ud50c ZIP(C10 \ud3f4\ub354)\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.", "accepted_diagnoses": ["\uac11\uc0c1\uc0d8\ud56d\uc9c4\uc99d(\uadf8\ub808\uc774\ube0c\uc2a4\ubcd1)", "\uadf8\ub808\uc774\ube0c\uc2a4\ubcd1", "\uadf8\ub808\uc774\ube0c\uc2a4\ubcd1\uc5d0 \uc758\ud55c \uac11\uc0c1\uc0d8\ud56d\uc9c4\uc99d", "\uac11\uc0c1\uc120\uae30\ub2a5\ud56d\uc9c4\uc99d(\uadf8\ub808\uc774\ube0c\uc2a4\ubcd1)", "\uadf8\ub808\uc774\ube0c\uc2a4\ubcd1\uc5d0 \uc758\ud55c \uac11\uc0c1\uc120\uae30\ub2a5\ud56d\uc9c4\uc99d", "Graves' disease", "Graves disease", "Hyperthyroidism due to Graves' disease"]}, {"case_id": "ef3649a9-330b-4e12-ad2d-fab94d019330", "version": 1, "initial": {"opening": "\uc774\ub984\uc740 \uae40\ub3c4\ud604\uc774\uace0, \uc5ec\uc12f \uc0b4 \ub0a8\uc790\uc544\uc774\uc774\ub2e4. \uc5c4\ub9c8 \uae40\uc9c0\uc601, \uc11c\ub978\uc77c\uacf1 \uc0b4\uc774 \ubcf4\ud638\uc790\ub85c \ud568\uaed8 \uc654\ub2e4. \uc5c4\ub9c8\ub294 \ub3c4\ud604\uc774 \ud0a4\uac00 \ub610\ub798\uc5d0 \ube44\ud574 \ub9ce\uc774 \uc791\uc740 \uac83 \uac19\uc544 \uac71\uc815\uc774 \ub41c\ub2e4\uace0 \ub9d0\ud588\ub2e4. \uc5b4\ub9b0\uc774\uc9d1\uc5d0\uc11c \uac19\uc740 \ubc18 \uce5c\uad6c\ub4e4\ubcf4\ub2e4 \ub3c4\ud604\uc774 \ud0a4\uac00 \ud655\uc2e4\ud788 \uc791\uc544 \ubcf4\uc778\ub2e4\uace0 \ud55c\ub2e4. \uc5c4\ub9c8\ub294 \uc77c \ub144 \uc804\ubd80\ud130 \uc8fc\ubcc0\uc5d0\uc11c \ub3c4\ud604\uc774\uac00 \ub610\ub798\ubcf4\ub2e4 \uc791\ub2e4\ub294 \ub9d0\uc744 \ub4e3\uae30 \uc2dc\uc791\ud588\ub2e4\uace0 \ud588\ub2e4. \ud2b9\ud788 \ucd5c\uadfc \uc721 \uac1c\uc6d4\uc5d0\uc11c \uc77c \ub144 \uc0ac\uc774\uc5d0 \ud0a4\uac00 \ubcc4\ub85c \ud06c\uc9c0 \uc54a\uc740 \uac83 \uac19\ub2e4\uace0 \ub290\uaf08\ub2e4. \uc5c4\ub9c8\uac00 \uc9d1\uc5d0\uc11c \ud0a4\ub97c \uc7ac\ubcf4\ub2c8, \uc77c \ub144 \uc804\uc5d0\ub294 \ubc31 \uc13c\ud2f0\ubbf8\ud130\uc600\uace0 \uc9c0\uae08\uc740 \ubc31\uc624 \uc13c\ud2f0\ubbf8\ud130 \uc815\ub3c4\uc600\ub2e4. \uc77c \ub144 \ub3d9\uc548 \uc624 \uc13c\ud2f0\ubbf8\ud130 \uc815\ub3c4 \uc790\ub790\ub2e4. \ubab8\ubb34\uac8c\ub294 \uc77c \ub144 \uc804 \uc2ed\uc624 \ud0a4\ub85c\uadf8\ub78c\uc5d0\uc11c \uc9c0\uae08\uc740 \uc2ed\uc721 \uc810 \uc624 \ud0a4\ub85c\uadf8\ub78c\uc73c\ub85c \uc77c \uc810 \uc624 \ud0a4\ub85c\uadf8\ub78c \ub298\uc5c8\ub2e4.", "vital_signs": "\ud608\uc555: 100/60 mmHg\n\ub9e5\ubc15: 90\ud68c/\ubd84\n\ud638\ud761: 20\ud68c/\ubd84\n\uccb4\uc628: 36.7\u00b0C"}, "explanation": "\uacf5\uac1c \uc0d8\ud50c C03. \ub300\ubcf8, \uc9c4\ucc30 \uacb0\uacfc\ud45c, \ubaa8\ubc94 \ucd08\uc9c4\uae30\ub85d\uc740 \uac1c\ubc1c \uac00\uc774\ub4dc\uc758 \uacf5\uac1c \uc0d8\ud50c ZIP(C03 \ud3f4\ub354)\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.", "accepted_diagnoses": ["\uccb4\uc9c8\uc131 \uc131\uc7a5\uc9c0\uc5f0", "\uccb4\uc9c8\uc131 \uc131\uc7a5 \ubc0f \uc0ac\ucd98\uae30 \uc9c0\uc5f0", "\uccb4\uc9c8\uc131 \uc800\uc2e0\uc7a5", "Constitutional delay of growth and puberty", "CDGP"]}]}